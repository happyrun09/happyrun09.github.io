    function initChecklist() {
      let saved = localStorage.getItem('lpn_checklist');
      let items = saved ? JSON.parse(saved) : defaultChecklist;
      renderChecklist(items);
    }

    function renderChecklist(items) {
      const container = document.getElementById('checklistItemsContainer');
      container.innerHTML = '';

      let doneCount = 0;
      items.forEach((item, index) => {
        if (item.done) doneCount++;

        const div = document.createElement('div');
        div.className = `p-3 rounded-xl border transition-all flex items-start gap-3 cursor-pointer ${
          item.done ? 'bg-emerald-950/20 border-emerald-500/40 text-slate-200' : 'bg-slate-950 border-slate-800 text-slate-400 hover:border-slate-700'
        }`;
        div.onclick = () => toggleChecklistItem(index);

        div.innerHTML = `
          <input type="checkbox" ${item.done ? 'checked' : ''} class="mt-0.5 rounded text-emerald-500 focus:ring-0">
          <span class="text-xs leading-relaxed ${item.done ? 'line-through text-slate-400' : 'text-slate-200'}">${item.label}</span>
        `;
        container.appendChild(div);
      });

      const percent = Math.round((doneCount / items.length) * 100);
      document.getElementById('checklistProgressPercent').textContent = `${percent}%`;
      document.getElementById('checklistProgressBar').style.width = `${percent}%`;

      const badge = document.getElementById('checklistBadgeAchieved');
      if (percent === 100) {
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }

    function toggleChecklistItem(index) {
      let saved = localStorage.getItem('lpn_checklist');
      let items = saved ? JSON.parse(saved) : defaultChecklist;
      items[index].done = !items[index].done;
      localStorage.setItem('lpn_checklist', JSON.stringify(items));
      renderChecklist(items);
    }

    function resetChecklist() {
      if (confirm('Bạn có chắc muốn đặt lại danh sách kiểm tra về mặc định?')) {
        localStorage.removeItem('lpn_checklist');
        initChecklist();
        showToast('Đã đặt lại danh sách kiểm tra!');
      }
    }

