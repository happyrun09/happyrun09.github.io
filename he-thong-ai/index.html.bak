    function generateAgentPrompt() {
      const role = document.getElementById('agRole').value;
      const goal = document.getElementById('agGoal').value;
      const tools = document.getElementById('agTools').value;
      const crit = document.getElementById('agCriteria').value;

      const p = `# SYSTEM PROMPT - ANTIGRAVITY AGENT
Role: ${role}
Goal: ${goal}
Authorized Tools: ${tools}
Execution Rules:
1. Luon giu quyen tu tri 100%, khong dung luong hoi lai.
2. Tao file .bak truoc khi sua code.
3. Kiem tra va giam sat tien do bang PROJECT_STATE.md.
Acceptance Criteria: ${crit}`;

      document.getElementById('agPromptBox').textContent = p;
      showToast('Đã biên dịch System Prompt!');
    }

    /* ================= 12. MÔ-ĐUN 09: MULTI-AI SIMULATOR ================= */
    function testAiConnection(provider) {
      const log = document.getElementById('aiConsoleLog');
      log.innerHTML = `<span class="text-amber-400">⏳ Đang gửi request kiểm tra kết nối tới ${provider.toUpperCase()}...</span>`;
      setTimeout(() => {
        if (provider === 'deepseek') {
          log.innerHTML = `<span class="text-emerald-400">✅ [DEEPSEEK] Kết nối thành công! HTTP 200 OK. Model: deepseek-chat. Độ trễ: 340ms. Sẵn sàng viết hook.</span>`;
        } else if (provider === 'gemini') {
          log.innerHTML = `<span class="text-emerald-400">✅ [GEMINI] Kết nối thành công! HTTP 200 OK. Model: gemini-2.5-flash. Độ trễ: 210ms. Hạn ngạch miễn phí khả dụng.</span>`;
        } else {
          log.innerHTML = `<span class="text-blue-400">✅ [VERTEX AI] Kết nối thành công! Google Cloud Project Ready. Số dư khuyến mại khả dụng: 300.00 USD.</span>`;
        }
      }, 700);
    }

