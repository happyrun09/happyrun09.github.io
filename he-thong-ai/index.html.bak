# Cơ chế DualAIBrain tự động nạp & xoay vòng khóa an toàn
from dotenv import load_dotenv
import os, requests

load_dotenv(override=True)
def get_ai_response(prompt):
    try:
        # Ưu tiên 1: DeepSeek API (Chuyên Hook & Caption)
        ds_key = os.getenv("DEEPSEEK_API_KEY")
        return call_deepseek(prompt, ds_key)
    except Exception as e:
        # Dự phòng 2: Gemini / Vertex AI Cloud
        gm_key = os.getenv("GEMINI_API_KEY")
        return call_gemini(prompt, gm_key)
