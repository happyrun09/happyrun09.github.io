    function searchTroubleIssues() {
      const q = document.getElementById('troubleSearchInput').value.toLowerCase().trim();
      renderTroubleList(q);
    }

    function setTroubleFilter(kw) {
      document.getElementById('troubleSearchInput').value = kw;
      renderTroubleList(kw.toLowerCase().trim());
    }

    function renderTroubleList(query) {
      const container = document.getElementById('troubleContainer');
      container.innerHTML = '';

      const filtered = troubleData.filter(item => {
        if (!query) return true;
        return item.keys.some(k => k.includes(query)) ||
               item.title.toLowerCase().includes(query) ||
               item.symptom.toLowerCase().includes(query);
      });

      if (filtered.length === 0) {
        container.innerHTML = `<div class="col-span-2 p-6 rounded-xl bg-slate-950 border border-slate-800 text-center text-slate-400 text-xs">Không tìm thấy mã lỗi phù hợp với từ khóa "${query}". Hãy thử gõ "401", "402", "quyền", hoặc "video".</div>`;
        return;
      }

      filtered.forEach((item, idx) => {
        const div = document.createElement('div');
        div.className = 'p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-2 text-xs';
        div.innerHTML = `
          <div class="flex justify-between items-start">
            <h4 class="font-bold text-rose-400">${item.title}</h4>
            <button onclick="copySnippet('fixCode-${idx}')" class="text-[11px] px-2 py-0.5 rounded bg-slate-800 border border-slate-700 text-slate-300 hover:text-white">Copy Lệnh Sửa</button>
          </div>
          <p class="text-slate-300"><strong>Triệu chứng:</strong> ${item.symptom}</p>
          <p class="text-slate-400"><strong>Nguyên nhân gốc:</strong> ${item.cause}</p>
          <div class="p-2.5 rounded bg-black/80 font-mono text-[11px] text-cyan-300 overflow-x-auto" id="fixCode-${idx}">${item.fix}</div>
        `;
        container.appendChild(div);
      });
    }

    /* ================= 9. MÔ-ĐUN 06: WORKFLOW BUILDER ================= */
    function updateWorkflowPreview() {
      const t = document.getElementById('wfTrigger').value;
      const i = document.getElementById('wfInput').value;
      const b = document.getElementById('wfBrain').value;
      const a = document.getElementById('wfAction').value;
      const o = document.getElementById('wfOutput').value;

      const prompt = `[AI WORKFLOW BLUEPRINT]
1. Trigger: ${t}
2. Input: ${i}
3. AI Brain: ${b}
4. Action: ${a}
5. Output: ${o}

Chiến lược thực thi: Agent AI tự động giám sát nguồn đầu vào, điều phối render video với caption chuẩn vàng 50–100 ký tự và xuất bản theo nhịp an toàn 45–75 giây.`;

      document.getElementById('wfPromptBox').textContent = prompt;
    }

    function exportWorkflowConfig() {
      const config = {
        name: "LPN_Custom_Workflow",
        trigger: document.getElementById('wfTrigger').value,
        input: document.getElementById('wfInput').value,
        brain: document.getElementById('wfBrain').value,
        action: document.getElementById('wfAction').value,
        output: document.getElementById('wfOutput').value,
        created_at: new Date().toISOString()
      };
      const blob = new Blob([JSON.stringify(config, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'workflow_config.json';
      a.click();
      URL.revokeObjectURL(url);
      showToast('Đã xuất file cấu hình workflow_config.json!');
    }

