<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MASTER COMMAND 3.0 — HỆ ĐIỀU HÀNH TỰ ĐỘNG HÓA AI TOÀN DÂN | LEPHUCNHAT.VN</title>
  <meta name="description" content="Hệ điều hành tự động hóa AI toàn dân - Lê Phúc Nhật. Tự trị 100% từ video reels, xuất bản 25 fanpage, đa khóa AI đến kiểm soát máy tính từ xa.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '"Be Vietnam Pro"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
            vietnam: ['"Be Vietnam Pro"', 'sans-serif']
          },
          colors: {
            brand: {
              50: '#eff6ff',
              100: '#dbeafe',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              accent: '#06b6d4',
              gold: '#f59e0b',
              emerald: '#10b981',
              rose: '#f43f5e'
            }
          }
        }
      }
    }
  </script>
  <style>
    /* Custom Scrollbar & Micro-interactions */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); }
    ::-webkit-scrollbar-thumb { background: rgba(100, 116, 139, 0.5); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(59, 130, 246, 0.8); }

    .glow-box {
      box-shadow: 0 0 25px -5px rgba(59, 130, 246, 0.25);
    }
    .glow-cyan {
      box-shadow: 0 0 25px -5px rgba(6, 182, 212, 0.25);
    }
    .glow-gold {
      box-shadow: 0 0 25px -5px rgba(245, 158, 11, 0.25);
    }
    .pulse-glow {
      animation: pulseGlow 3s infinite ease-in-out;
    }
    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 15px rgba(59, 130, 246, 0.2); }
      50% { box-shadow: 0 0 30px rgba(6, 182, 212, 0.4); }
    }
    .flow-line {
      stroke-dasharray: 8;
      animation: dash 1.5s linear infinite;
    }
    @keyframes dash {
      to { stroke-dashoffset: -16; }
    }
    .badge-gold {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(217, 119, 6, 0.3));
      border: 1px solid rgba(245, 158, 11, 0.4);
    }

    /* ===== HOTFIX 3.1: LIGHT MODE (html:not(.dark)) ===== */
    html:not(.dark) body { background-color: #f8fafc !important; color: #0f172a; }
    html:not(.dark) .bg-slate-950,
    html:not(.dark) .bg-slate-950\/85,
    html:not(.dark) .bg-slate-950\/90 { background-color: #f8fafc !important; }
    html:not(.dark) .bg-slate-900,
    html:not(.dark) .bg-slate-900\/40,
    html:not(.dark) .bg-slate-900\/60,
    html:not(.dark) .bg-slate-900\/90 { background-color: #ffffff !important; }
    html:not(.dark) .bg-slate-800 { background-color: #e2e8f0 !important; }
    html:not(.dark) .bg-black\/90,
    html:not(.dark) .bg-black\/80 { background-color: #f1f5f9 !important; border: 1px solid #cbd5e1; }
    html:not(.dark) .bg-amber-950\/30 { background-color: #fffbeb !important; }
    html:not(.dark) .bg-cyan-950\/60 { background-color: #ecfeff !important; }
    html:not(.dark) .bg-emerald-950\/20,
    html:not(.dark) .bg-emerald-950\/60 { background-color: #ecfdf5 !important; }
    html:not(.dark) .bg-rose-950\/40,
    html:not(.dark) .bg-rose-950\/60 { background-color: #fff1f2 !important; }
    html:not(.dark) .from-blue-900\/60,
    html:not(.dark) .from-slate-950 {
      --tw-gradient-from: #dbeafe var(--tw-gradient-from-position) !important;
      --tw-gradient-to: rgba(248, 250, 252, 0) var(--tw-gradient-to-position) !important;
      --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to) !important;
    }
    html:not(.dark) .via-slate-900,
    html:not(.dark) .via-slate-900\/50 { --tw-gradient-stops: var(--tw-gradient-from), #ffffff var(--tw-gradient-via-position), var(--tw-gradient-to) !important; }
    html:not(.dark) .to-indigo-950\/60,
    html:not(.dark) .to-slate-950 { --tw-gradient-to: #e0e7ff var(--tw-gradient-to-position) !important; }
    html:not(.dark) .border-slate-700,
    html:not(.dark) .border-slate-800,
    html:not(.dark) .border-slate-800\/80,
    html:not(.dark) .divide-slate-800\/60 > * + * { border-color: #cbd5e1 !important; }
    html:not(.dark) .hover\:border-slate-700:hover { border-color: #94a3b8 !important; }
    html:not(.dark) .text-slate-100,
    html:not(.dark) .text-slate-200,
    html:not(.dark) .text-slate-300,
    html:not(.dark) .text-slate-400,
    html:not(.dark) .text-white { color: #0f172a !important; }
    html:not(.dark) .text-slate-500 { color: #475569 !important; }
    html:not(.dark) .hover\:text-white:hover { color: #0f172a !important; }
    html:not(.dark) .hover\:bg-slate-700:hover,
    html:not(.dark) .hover\:bg-slate-800:hover,
    html:not(.dark) .hover\:bg-slate-800\/40:hover { background-color: #cbd5e1 !important; }
    html:not(.dark) .text-blue-300, html:not(.dark) .text-blue-400 { color: #1d4ed8 !important; }
    html:not(.dark) .text-cyan-300, html:not(.dark) .text-cyan-400 { color: #0e7490 !important; }
    html:not(.dark) .text-emerald-300, html:not(.dark) .text-emerald-400 { color: #047857 !important; }
    html:not(.dark) .text-amber-300, html:not(.dark) .text-amber-400 { color: #b45309 !important; }
    html:not(.dark) .text-rose-300, html:not(.dark) .text-rose-400 { color: #be123c !important; }
    html:not(.dark) .text-purple-300, html:not(.dark) .text-purple-400 { color: #7e22ce !important; }
    html:not(.dark) .text-indigo-300, html:not(.dark) .text-indigo-400 { color: #4338ca !important; }
    /* Giữ chữ trắng cho nút/badge nền màu đậm */
    html:not(.dark) .bg-blue-600, html:not(.dark) .bg-cyan-600, html:not(.dark) .bg-emerald-600,
    html:not(.dark) .bg-purple-600, html:not(.dark) .bg-rose-600, html:not(.dark) .bg-amber-600,
    html:not(.dark) .bg-indigo-600, html:not(.dark) .from-blue-600,
    html:not(.dark) .bg-blue-600 *, html:not(.dark) .bg-cyan-600 *, html:not(.dark) .bg-emerald-600 *,
    html:not(.dark) .bg-purple-600 *, html:not(.dark) .bg-rose-600 *, html:not(.dark) .bg-amber-600 *,
    html:not(.dark) .bg-indigo-600 *, html:not(.dark) .from-blue-600 .text-white { color: #ffffff !important; }
    html:not(.dark) .from-blue-600 .bg-slate-950 { background-color: #ffffff !important; }
    html:not(.dark) ::-webkit-scrollbar-track { background: #e2e8f0; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans selection:bg-blue-600 selection:text-white transition-colors duration-200">

  <!-- ================= TOP NOTIFICATION / SYSTEM TICKER ================= -->
  <div class="bg-gradient-to-r from-blue-900/60 via-slate-900 to-indigo-950/60 border-b border-blue-500/20 text-xs py-2 px-4">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span class="font-bold text-emerald-400">TRẠNG THÁI HỆ THỐNG: HOẠT ĐỘNG 100%</span>
        <span class="text-slate-400 hidden sm:inline">|</span>
        <span class="text-slate-300 hidden md:inline">25 Fanpage Meta Business Suite • Dual-AI Router (DeepSeek + Gemini) • Playwright Active</span>
      </div>
      <div class="flex items-center gap-4">
        <span class="text-amber-300 font-mono font-medium">Phiên bản Master: 3.0 Pro</span>
        <a href="https://lephucnhat.vn" class="text-blue-400 hover:text-blue-300 font-semibold underline underline-offset-4 flex items-center gap-1">
          Trang chủ lephucnhat.vn &rarr;
        </a>
      </div>
    </div>
  </div>

  <!-- ================= HEADER & NAVIGATION BAR ================= -->
  <header class="sticky top-0 z-50 backdrop-blur-xl bg-slate-950/85 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
        <!-- Logo & Branding -->
        <div class="flex items-center justify-between">
          <a href="#" class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 via-indigo-600 to-cyan-500 p-0.5 shadow-lg shadow-blue-500/20 group-hover:scale-105 transition">
              <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300 text-lg">
                MC
              </div>
            </div>
            <div>
              <div class="font-black text-base tracking-tight text-white flex items-center gap-1.5">
                MASTER COMMAND 3.0
                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-400 border border-blue-500/30">WEB-OS</span>
              </div>
              <div class="text-[11px] text-slate-400 font-medium">Hệ Điều Hành Tự Động Hóa AI Toàn Dân • Lê Phúc Nhật</div>
            </div>
          </a>

          <!-- Mobile Theme & Toggle Button -->
          <div class="flex items-center gap-2 lg:hidden">
            <button id="themeToggleBtnMobile" class="p-2 rounded-lg bg-slate-900 border border-slate-700 text-slate-300 hover:text-white" title="Chuyển Dark/Light Mode">
              <span id="themeIconMobile">🌙</span>
            </button>
          </div>
        </div>

        <!-- 3 User Modes Pill Switcher (Trọng tâm trải nghiệm) -->
        <div class="flex items-center justify-center p-1 rounded-xl bg-slate-900/90 border border-slate-800 overflow-x-auto">
          <button id="modeBtnBeginner" onclick="switchUserMode('beginner')" class="mode-pill px-3 sm:px-4 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 whitespace-nowrap bg-blue-600 text-white shadow-md">
            <span>🌱</span> Người Mới (Zero to Hero)
          </button>
          <button id="modeBtnCreator" onclick="switchUserMode('creator')" class="mode-pill px-3 sm:px-4 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 whitespace-nowrap text-slate-400 hover:text-white">
            <span>🎬</span> Nhà Sáng Tạo & Xây Kênh
          </button>
          <button id="modeBtnPro" onclick="switchUserMode('pro')" class="mode-pill px-3 sm:px-4 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 whitespace-nowrap text-slate-400 hover:text-white">
            <span>⚡</span> Kiến Trúc Sư Hệ Thống
          </button>
        </div>

        <!-- Quick Nav & Theme Toggle Desktop -->
        <div class="hidden lg:flex items-center gap-3">
          <a href="#tru-cot" class="text-xs font-semibold text-slate-300 hover:text-blue-400 transition">8 Trụ Cột</a>
          <a href="#mo-duon" class="text-xs font-semibold text-slate-300 hover:text-blue-400 transition">12 Mô-đun</a>
          <a href="#ban-do-luong" class="text-xs font-semibold text-slate-300 hover:text-blue-400 transition">Bản Đồ Luồng</a>
          <a href="#mo-duon-05" class="text-xs font-semibold text-slate-300 hover:text-blue-400 transition">Chẩn Đoán</a>
          <button id="themeToggleBtn" onclick="toggleTheme()" class="p-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:text-white transition" title="Chuyển chế độ Sáng / Tối">
            <span id="themeIcon">🌙</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- ================= HERO SECTION ================= -->
  <section class="relative overflow-hidden pt-12 pb-16 border-b border-slate-800/80 bg-gradient-to-b from-slate-950 via-slate-900/50 to-slate-950">
    <!-- Background Ambient Glow -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-blue-600/10 blur-[120px] pointer-events-none rounded-full"></div>
    <div class="absolute -top-10 right-10 w-96 h-96 bg-cyan-500/10 blur-[100px] pointer-events-none rounded-full"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-blue-400 animate-ping"></span>
          Kiến Trúc Tự Động Hóa 2 Lớp: Web-OS + Local Agent Thực Chiến
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white font-vietnam leading-tight">
          HỆ ĐIỀU HÀNH TỰ ĐỘNG HÓA <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-cyan-300 to-indigo-400">AI TOÀN DÂN</span>
        </h1>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
          Biến máy tính cá nhân thành <strong class="text-white">cỗ máy tự trị 100%</strong>: Tự động sản xuất Video Reels hàng loạt, tự xuất bản 25 Fanpage Meta Business Suite, quản trị xoay vòng đa khóa AI (Gemini + DeepSeek), điều khiển từ xa qua điện thoại và giám sát thời gian thực.
        </p>

        <!-- Dynamic Mode Description Callout -->
        <div id="modeDescriptionBox" class="p-4 rounded-xl bg-slate-900/90 border border-blue-500/30 text-left max-w-2xl mx-auto transition-all duration-300 shadow-lg">
          <div class="flex items-start gap-3">
            <span class="text-2xl" id="modeIconCallout">🌱</span>
            <div>
              <h4 class="text-sm font-bold text-white flex items-center gap-2" id="modeTitleCallout">
                Đang xem chế độ: NGƯỜI MỚI (Zero to Hero)
              </h4>
              <p class="text-xs text-slate-300 mt-1" id="modeTextCallout">
                Dành cho người chưa từng gõ code. Bạn chỉ cần nhập đường dẫn thư mục và chat ID Telegram, hệ thống sẽ tự sinh file cài đặt 1 chạm và video hướng dẫn từng bước.
              </p>
            </div>
          </div>
        </div>

        <!-- Quick Action CTAs -->
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
          <a href="#mo-duon-01" class="px-5 py-3 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-600 text-white font-bold text-sm shadow-lg shadow-blue-500/25 hover:brightness-110 hover:scale-[1.02] transition flex items-center gap-2">
            <span>⚡</span> Tạo File Cài Đặt 1 Chạm Ngay
          </a>
          <a href="#ban-do-luong" class="px-5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-slate-200 font-bold text-sm hover:bg-slate-800 hover:text-white transition flex items-center gap-2">
            <span>🗺️</span> Bản Đồ Luồng Dữ Liệu
          </a>
          <a href="#mo-duon-05" class="px-5 py-3 rounded-xl bg-rose-950/40 border border-rose-600/40 text-rose-300 font-bold text-sm hover:bg-rose-900/40 transition flex items-center gap-2">
            <span>🩺</span> Bác Sĩ Cứu Hộ Lỗi
          </a>
        </div>

        <!-- Live Metrics Bar -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-6 border-t border-slate-800/80">
          <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800">
            <div class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300 font-mono">25 KÊNH</div>
            <div class="text-[11px] text-slate-400 font-medium">Fanpage Tự Xuất Bản</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800">
            <div class="text-2xl font-black text-emerald-400 font-mono">100%</div>
            <div class="text-[11px] text-slate-400 font-medium">Tự Trị Không Cần Hỏi</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800">
            <div class="text-2xl font-black text-amber-400 font-mono">45-75s</div>
            <div class="text-[11px] text-slate-400 font-medium">Nhịp Nghỉ Chống Checkpoint</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800">
            <div class="text-2xl font-black text-purple-400 font-mono">DUAL-AI</div>
            <div class="text-[11px] text-slate-400 font-medium">DeepSeek R1 + Gemini</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= MAIN CONTENT CONTAINER ================= -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-10 space-y-16">

    <!-- ================= SECTION 1: BẢN ĐỒ KIẾN TRÚC 2 LỚP & DÒNG CHẢY DỮ LIỆU (MODULE 03) ================= -->
    <section id="ban-do-luong" class="scroll-mt-24 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <div class="text-xs font-bold text-blue-400 uppercase tracking-wider">MÔ-ĐUN 03 & KIẾN TRÚC TỔNG THỂ</div>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-vietnam">Bản Đồ Kiến Trúc Luồng Dữ Liệu Tương Tác</h2>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">Bấm vào bất kỳ khối nào trên sơ đồ để xem thông số kỹ thuật, mã lệnh PowerShell và cơ chế vận hành.</p>
        </div>
        <div class="flex items-center gap-2 text-xs">
          <span class="inline-block w-3 h-3 rounded-full bg-blue-500 animate-pulse"></span>
          <span class="text-slate-300 font-mono">Dòng chảy dữ liệu thời gian thực</span>
        </div>
      </div>

      <!-- Sơ đồ kiến trúc tương tác -->
      <div class="p-6 rounded-2xl bg-slate-900/90 border border-slate-800 shadow-xl overflow-hidden relative">
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-4 relative z-10">
          
          <!-- Node 1: Remote Mobile -->
          <div onclick="inspectArchNode('node-mobile')" class="arch-node cursor-pointer p-4 rounded-xl bg-slate-950 border border-blue-500/40 hover:border-blue-400 hover:scale-105 transition-all text-center space-y-2 group">
            <div class="w-12 h-12 mx-auto rounded-xl bg-blue-500/10 flex items-center justify-center text-2xl group-hover:bg-blue-500/20 transition">📱</div>
            <div class="font-bold text-xs text-white">1. Điện Thoại</div>
            <div class="text-[10px] text-blue-400 font-mono">Telegram & Remote</div>
            <div class="text-[10px] text-slate-400">Giám sát & nhận báo cáo ảnh tức thì</div>
          </div>

          <!-- Node 2: Local Agent PC -->
          <div onclick="inspectArchNode('node-pc')" class="arch-node cursor-pointer p-4 rounded-xl bg-slate-950 border border-cyan-500/40 hover:border-cyan-400 hover:scale-105 transition-all text-center space-y-2 group">
            <div class="w-12 h-12 mx-auto rounded-xl bg-cyan-500/10 flex items-center justify-center text-2xl group-hover:bg-cyan-500/20 transition">💻</div>
            <div class="font-bold text-xs text-white">2. Local Agent PC</div>
            <div class="text-[10px] text-cyan-400 font-mono">PowerShell & Task</div>
            <div class="text-[10px] text-slate-400">Windows Env & Quyền vĩnh viễn Option 3</div>
          </div>

          <!-- Node 3: Multi-AI Brain -->
          <div onclick="inspectArchNode('node-ai')" class="arch-node cursor-pointer p-4 rounded-xl bg-slate-950 border border-purple-500/40 hover:border-purple-400 hover:scale-105 transition-all text-center space-y-2 group">
            <div class="w-12 h-12 mx-auto rounded-xl bg-purple-500/10 flex items-center justify-center text-2xl group-hover:bg-purple-500/20 transition">🧠</div>
            <div class="font-bold text-xs text-white">3. Dual-AI Router</div>
            <div class="text-[10px] text-purple-400 font-mono">DeepSeek + Gemini</div>
            <div class="text-[10px] text-slate-400">Viết hook viral & kiểm tra đa luồng</div>
          </div>

          <!-- Node 4: Video Studio -->
          <div onclick="inspectArchNode('node-video')" class="arch-node cursor-pointer p-4 rounded-xl bg-slate-950 border border-amber-500/40 hover:border-amber-400 hover:scale-105 transition-all text-center space-y-2 group">
            <div class="w-12 h-12 mx-auto rounded-xl bg-amber-500/10 flex items-center justify-center text-2xl group-hover:bg-amber-500/20 transition">🎬</div>
            <div class="font-bold text-xs text-white">4. Xưởng Reels FFmpeg</div>
            <div class="text-[10px] text-amber-400 font-mono">Kho B-Roll 9:16</div>
