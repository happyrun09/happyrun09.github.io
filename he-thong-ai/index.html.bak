# Gửi ảnh chụp màn hình bằng chứng bài đăng lên Telegram
import telebot, os
bot = telebot.TeleBot(os.getenv("TELEGRAM_BOT_TOKEN"))
chat_id = os.getenv("TELEGRAM_CHAT_ID")
def send_proof(image_path, caption):
    with open(image_path, 'rb') as photo:
        bot.send_photo(chat_id, photo, caption=f"✅ Đã xuất bản: {caption}")
