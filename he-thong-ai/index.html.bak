    function initTemplates() {
      const container = document.getElementById('templateListContainer');
      container.innerHTML = '';
      templatesData.forEach((tmpl, idx) => {
        const div = document.createElement('div');
        div.className = 'p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-2.5 text-xs hover:border-amber-500/40 transition-all';
        div.innerHTML = `
          <h4 class="font-bold text-white text-sm">${tmpl.title}</h4>
          <p class="text-slate-400 text-[11px] leading-relaxed">${tmpl.desc}</p>
          <div class="pt-2 flex gap-2">
            <button onclick="viewTemplate('${tmpl.id}')" class="px-2.5 py-1 rounded bg-amber-600/20 text-amber-300 border border-amber-500/30 hover:bg-amber-600/30 font-semibold">Xem Script</button>
            <button onclick="copyTemplateById('${tmpl.id}')" class="px-2.5 py-1 rounded bg-slate-800 text-slate-300 hover:text-white border border-slate-700">Copy</button>
          </div>
        `;
        container.appendChild(div);
      });
    }

    function viewTemplate(id) {
      const tmpl = templatesData.find(t => t.id === id);
      if (!tmpl) return;
      document.getElementById('tmplTitle').textContent = tmpl.title;
      document.getElementById('tmplCodeBox').textContent = tmpl.code;
      document.getElementById('templateDetailView').classList.remove('hidden');
    }

    function closeTemplateView() {
      document.getElementById('templateDetailView').classList.add('hidden');
    }

    function copySnippetText(txt) {
      navigator.clipboard.writeText(txt).then(() => {
        showToast('Đã copy mã script mẫu!');
      });
    }

    function copyTemplateById(id) {
      const tmpl = templatesData.find(t => t.id === id);
      if (!tmpl) return;
      copySnippetText(tmpl.code);
    }

