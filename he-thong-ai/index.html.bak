      { slot: "#23", page: "HTX Lâm Nghiệp KSFC", id: "108697177283413", status: "SUCCESS", time: "23:10:46", caption: "Rừng xanh có đang nuôi sống bà con mình? #LamNghiepBenVung" },
      { slot: "#24", page: "Cao Dược Liệu TAPO", id: "104617941002786", status: "SUCCESS", time: "23:12:46", caption: "Bạn có đang giữ ấm bữa sáng đúng cách cho cả nhà? #TAPO #NongSanSach" },
      { slot: "#25", page: "Mật Mật Ong Rừng", id: "234427604062086", status: "SUCCESS", time: "23:15:20", caption: "Bạn có tin một giọt mật chứa cả khu rừng? #MatMatOngRung" }
    ];

    let currentHistory = [...sampleHistory];
    let fanpageStatusFilter = 'all';

    function loadSampleHistory() {
      currentHistory = [...sampleHistory];
      renderHistoryTable();
      showToast('Đã tải dữ liệu chiến dịch mới nhất hôm nay (19/24 thành công)!');
    }

    function handleHistoryFileUpload(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const parsed = JSON.parse(e.target.result);
          if (Array.isArray(parsed)) {
            currentHistory = parsed.map((item, idx) => ({
              slot: item.slot || `#${idx+1}`,
              page: item.page_name || item.name || item.page || `Fanpage ${idx+1}`,
              id: item.page_id || item.id || '-',
              status: (item.status || 'SUCCESS').toUpperCase(),
              time: item.time || item.updated_at || 'Vừa xong',
              caption: item.caption || item.text || '(Không có caption)'
            }));
          } else if (typeof parsed === 'object') {
            // If it's a key-value object of pages
            currentHistory = Object.keys(parsed).map((k, idx) => {
              const val = parsed[k];
              return {
                slot: `#${idx+1}`,
                page: val.page_name || k,
                id: val.page_id || k,
                status: (val.status || 'SUCCESS').toUpperCase(),
                time: val.published_at || 'Vừa xong',
                caption: val.caption || '(Đã xuất bản)'
              };
            });
          }
          renderHistoryTable();
          showToast(`Đã đọc thành công ${currentHistory.length} kênh từ file của bạn!`);
        } catch (err) {
          alert('Lỗi định dạng JSON: ' + err.message);
        }
      };
      reader.readAsText(file);
    }

    function renderHistoryTable() {
      const tbody = document.getElementById('fanpageTableBody');
      tbody.innerHTML = '';

      let successCount = 0;
      let failedCount = 0;

      const q = (document.getElementById('fanpageTableSearch').value || '').toLowerCase().trim();

      const filtered = currentHistory.filter(item => {
        const matchesStatus = fanpageStatusFilter === 'all' || item.status === fanpageStatusFilter;
        const matchesSearch = !q || item.page.toLowerCase().includes(q) || item.id.includes(q) || item.caption.toLowerCase().includes(q);
        return matchesStatus && matchesSearch;
      });

      // Recalculate metrics on whole dataset
      currentHistory.forEach(item => {
        if (item.status === 'SUCCESS') successCount++;
        else failedCount++;
      });

      const total = currentHistory.length;
      document.getElementById('dashTotal').textContent = total;
      document.getElementById('dashSuccess').textContent = successCount;
      document.getElementById('dashFailed').textContent = failedCount;
      document.getElementById('dashRate').textContent = total > 0 ? `${((successCount/total)*100).toFixed(1)}%` : '0%';

      filtered.forEach(item => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-800/40 transition';
        const isSuccess = item.status === 'SUCCESS';
        tr.innerHTML = `
          <td class="p-3 font-mono font-bold text-slate-400">${item.slot}</td>
          <td class="p-3 font-bold text-white">${item.page}</td>
          <td class="p-3 font-mono text-[11px] text-slate-400">${item.id}</td>
          <td class="p-3">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold font-mono ${
              isSuccess ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-rose-500/20 text-rose-400 border border-rose-500/30'
            }">${item.status}</span>
          </td>
          <td class="p-3 font-mono text-[11px] text-slate-400">${item.time}</td>
          <td class="p-3 text-[11px] text-slate-300 max-w-xs truncate" title="${item.caption}">${item.caption}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function filterFanpageTable() {
      renderHistoryTable();
    }

    function setFanpageStatusFilter(st) {
      fanpageStatusFilter = st;
      renderHistoryTable();
    }

    /* ================= 14. MÔ-ĐUN 12: BACKUP & RECOVERY ================= */
    function exportWebOsState() {
      const state = {
        app: "MASTER_COMMAND_3_0",
        author: "Le Phuc Nhat",
        exported_at: new Date().toISOString(),
        user_mode: currentMode,
        checklist: localStorage.getItem('lpn_checklist') || JSON.stringify(defaultChecklist),
        custom_path: document.getElementById('genPath').value,
        custom_topic: document.getElementById('genTopic').value,
        telegram_chat_id: document.getElementById('genTelegram').value
      };
      const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `LPN_WebOS_State_${new Date().toISOString().slice(0,10)}.json`;
      a.click();
      URL.revokeObjectURL(url);
      showToast('Đã xuất bản sao lưu cấu hình thành công!');
    }

    function importWebOsState(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const parsed = JSON.parse(e.target.result);
          if (parsed.checklist) {
            localStorage.setItem('lpn_checklist', parsed.checklist);
            initChecklist();
          }
          if (parsed.user_mode) {
            switchUserMode(parsed.user_mode);
          }
          if (parsed.custom_path) document.getElementById('genPath').value = parsed.custom_path;
          if (parsed.custom_topic) document.getElementById('genTopic').value = parsed.custom_topic;
          if (parsed.telegram_chat_id) document.getElementById('genTelegram').value = parsed.telegram_chat_id;
          updateGeneratedScript();
          showToast('Đã khôi phục dữ liệu Web-OS thành công!');
        } catch (err) {
          alert('File JSON không hợp lệ: ' + err.message);
        }
      };
      reader.readAsText(file);
    }

    /* ================= 15. TOAST NOTIFICATION UTILITY ================= */
    function showToast(message) {
      let toast = document.getElementById('lpnGlobalToast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'lpnGlobalToast';
        toast.className = 'fixed bottom-6 right-6 z-50 px-4 py-2.5 rounded-xl bg-blue-600 text-white font-bold text-xs shadow-2xl flex items-center gap-2 transform transition-all duration-300 translate-y-20 opacity-0';
        document.body.appendChild(toast);
      }
      toast.innerHTML = `<span>✨</span> ${message}`;
      toast.classList.remove('translate-y-20', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 3000);
    }

    /* ================= INITIALIZATION ON LOAD ================= */
    window.addEventListener('DOMContentLoaded', () => {
      initTheme();
      const savedMode = localStorage.getItem('lpn_user_mode') || 'beginner';
      switchUserMode(savedMode);
      filterPillars('all');
      initChecklist();
      renderTroubleList('');
      initTemplates();
      updateWorkflowPreview();
      updateGeneratedScript();
      generateAgentPrompt();
      renderHistoryTable();

      // Mobile theme button bind
      const mobileBtn = document.getElementById('themeToggleBtnMobile');
      if (mobileBtn) mobileBtn.addEventListener('click', toggleTheme);
    });
  </script>
</body>
</html>
