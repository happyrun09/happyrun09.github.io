  <!-- ================= JAVASCRIPT LOGIC TRỌN BỘ 100% VANILLA JS ================= -->
  <script>
    /* ================= 1. THEME SWITCHER (DARK / LIGHT) ================= */
    function initTheme() {
      const savedTheme = localStorage.getItem('lpn_theme') || 'dark';
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('dark');
        updateThemeIcons('☀️');
      } else {
        document.documentElement.classList.add('dark');
        updateThemeIcons('🌙');
      }
    }
    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      const icon = isDark ? '🌙' : '☀️';
      localStorage.setItem('lpn_theme', isDark ? 'dark' : 'light');
      updateThemeIcons(icon);
    }
    function updateThemeIcons(icon) {
      const btn = document.getElementById('themeIcon');
      const btnMobile = document.getElementById('themeIconMobile');
      if (btn) btn.textContent = icon;
      if (btnMobile) btnMobile.textContent = icon;
    }

    /* ================= 2. USER MODES SWITCHER (3 CHẾ ĐỘ) ================= */
    let currentMode = 'beginner';
    const modeConfig = {
      beginner: {
        icon: '🌱',
        title: 'Đang xem chế độ: NGƯỜI MỚI (Zero to Hero)',
        desc: 'Ngôn ngữ đời thường, sơ đồ trực quan từng bước. Bạn chỉ cần nhập thông tin cơ bản &rarr; Bấm tải file về máy &rarr; Bấm đúp chuột là hệ thống tự khởi chạy.',
        filter: 'core'
      },
      creator: {
        icon: '🎬',
        title: 'Đang xem chế độ: NHÀ SÁNG TẠO & XÂY KÊNH (Creator & Business)',
        desc: 'Tập trung tối đa vào sản xuất video Reels hàng loạt, tối ưu Caption 50–100 ký tự kéo bình luận, kiểm tra độ trùng lặp và quản lý chiến dịch 25 Fanpage Meta Business Suite.',
        filter: 'media'
      },
      pro: {
        icon: '⚡',
        title: 'Đang xem chế độ: KIẾN TRÚC SƯ HỆ THỐNG (Pro Automation)',
        desc: 'Đi sâu vào kiến trúc code Python lõi, Playwright xử lý bất đồng bộ, bộ não Dual-AI Router xoay vòng API key, biến môi trường Windows User Env và CI/CD GitHub.',
        filter: 'ops'
      }
    };

    function switchUserMode(mode) {
      currentMode = mode;
      localStorage.setItem('lpn_user_mode', mode);

      // Update Pill Buttons
      document.querySelectorAll('.mode-pill').forEach(btn => {
        btn.classList.remove('bg-blue-600', 'text-white', 'shadow-md');
        btn.classList.add('text-slate-400');
      });
      const activeBtn = document.getElementById(
        mode === 'beginner' ? 'modeBtnBeginner' :
        mode === 'creator' ? 'modeBtnCreator' : 'modeBtnPro'
      );
      if (activeBtn) {
        activeBtn.classList.remove('text-slate-400');
        activeBtn.classList.add('bg-blue-600', 'text-white', 'shadow-md');
      }

      // Update Callout Box
      const conf = modeConfig[mode];
      document.getElementById('modeIconCallout').textContent = conf.icon;
      document.getElementById('modeTitleCallout').textContent = conf.title;
      document.getElementById('modeTextCallout').innerHTML = conf.desc;

      // Filter pillars slightly to match focus
      filterPillars(conf.filter);
    }

    /* ================= 3. ARCHITECTURE MAP INSPECTOR ================= */
    const nodeDetails = {
      'node-mobile': {
        badge: 'KHỐI 1: ĐIỆN THOẠI & ĐIỀU KHIỂN TỪ XA',
        title: 'Telegram Bot & Chrome Remote Desktop Mobile',
        desc: 'Nhận ảnh chụp màn hình bằng chứng bài đăng từng kênh theo thời gian thực. Điều khiển toàn bộ màn hình máy tính thông qua ứng dụng di động bảo mật 2 lớp.',
        code: `# Kịch bản bot Telegram thông báo tiến độ:
bot.send_photo(chat_id, photo, caption="✅ Slot #02: Happy Chay đã đăng bài thành công!")`
      },
      'node-pc': {
        badge: 'KHỐI 2: LOCAL AGENT PC',
        title: 'Máy tính cá nhân Windows (ASUS TUF Gaming F15)',
        desc: 'Cấp quyền vĩnh viễn Option 3 cho Agent AI trong Antigravity, nạp biến môi trường hệ thống Windows User Env, điều khiển chạy ngầm PowerShell và Task Scheduler.',
        code: `# Nạp biến môi trường Windows User Environment:
[System.Environment]::SetEnvironmentVariable("DEEPSEEK_API_KEY", "sk-xxxx", "User")`
      },
      'node-ai': {
        badge: 'KHỐI 3: DUAL-AI ROUTER',
        title: 'Bộ Não AI Kép (DeepSeek V3/R1 + Gemini 2.5 Flash)',
        desc: 'DeepSeek đảm nhận viết hook mở đầu kích thích bình luận; Gemini kiểm duyệt an toàn, tóm tắt dữ liệu lớn. Tự động chuyển đổi nếu một bên gặp lỗi 402 hoặc 429.',
        code: `# Dual AI Router logic (ai_core_brain.py):
try:
    res = ask_deepseek(prompt)
except Exception:
    res = ask_gemini(prompt)`
      },
      'node-video': {
        badge: 'KHỐI 4: XƯỞNG REELS FFMPEG',
        title: 'Kho Nguyên Liệu B-Roll & Render Tự Động',
        desc: 'Quản lý kho video cảnh đẹp, thư giãn, thiên nhiên. Tự động cắt ghép tỉ lệ dọc 9:16 (1080x1920), hòa trộn nhạc nền thiền và sinh caption 50–100 ký tự vàng.',
        code: `ffmpeg -i broll.mp4 -i audio.mp3 -c:v libx264 -preset fast -crf 22 -shortest output_reels.mp4`
      },
      'node-fb': {
        badge: 'KHỐI 5: CỖ MÁY PLAYWRIGHT',
        title: 'Xuất Bản Tự Động 25 Fanpage Meta Business Suite',
        desc: 'Điều hướng trực tiếp URL Reels Composer theo Page ID, tự động nhấn phím Escape đóng popup, nạp file qua locator attached và giữ nhịp nghỉ 45–75 giây an toàn.',
        code: `page.goto(f"https://business.facebook.com/latest/reels_composer?page_id={page_id}")
page.locator('input[type="file"]').set_input_files(file_path)`
      },
      'node-web': {
        badge: 'KHỐI 6: WEB HUB LEPHUCNHAT.VN',
        title: 'Hệ Điều Hành Web-in-Web Trực Tuyến & GitHub CI/CD',
        desc: 'Lưu trữ tài liệu, công cụ sinh script, đồng bộ tự động với kho GitHub happyrun09.github.io và phân phối qua mạng CDN toàn cầu.',
        code: `git add . && git commit -m "deploy: update ai os" && git push origin main`
      }
    };

    function inspectArchNode(nodeKey) {
      const data = nodeDetails[nodeKey];
      if (!data) return;
      document.getElementById('detailBadge').textContent = data.badge;
      document.getElementById('detailTitle').textContent = data.title;
      document.getElementById('detailDesc').textContent = data.desc;
      document.getElementById('detailCodeBox').textContent = data.code;
    }

    function copyDetailCode() {
      const code = document.getElementById('detailCodeBox').textContent;
      navigator.clipboard.writeText(code).then(() => {
        showToast('Đã sao chép mã lệnh khối kiến trúc!');
      });
    }

    /* ================= 4. PILLARS FILTERING & COPY ================= */
    function filterPillars(category) {
      document.querySelectorAll('.pillar-card').forEach(card => {
        if (category === 'all' || card.getAttribute('data-category') === category) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
      // Cập nhật màu nút tab đang chọn
      document.querySelectorAll('.pillar-tab').forEach(btn => {
        const m = (btn.getAttribute('onclick') || '').match(/filterPillars\('([^']+)'\)/);
        const active = !!m && m[1] === category;
        btn.classList.remove('bg-blue-600', 'text-white', 'bg-slate-800', 'text-slate-300');
        if (active) {
          btn.classList.add('bg-blue-600', 'text-white');
        } else {
          btn.classList.add('bg-slate-800', 'text-slate-300');
        }
      });
    }

    function copySnippet(elementId) {
      const el = document.getElementById(elementId);
      if (!el) return;
      navigator.clipboard.writeText(el.textContent.trim()).then(() => {
        showToast('Đã sao chép mã lệnh thành công!');
      });
    }

    /* ================= 5. MÔ-ĐUN 01: SCRIPT & PROMPT GENERATOR ================= */
    function updateGeneratedScript() {
      const p = document.getElementById('genPath').value || 'D:\\LPN_Workspace';
      const pages = document.getElementById('genPages').value || '25';
      const topic = document.getElementById('genTopic').value;
      const tele = document.getElementById('genTelegram').value || 'CHUA_CAU_HINH';

      const promptText = `================ SIÊU CÂU LỆNH ANTIGRAVITY MASTER COMMAND 3.0 ================
Bạn là Tổng công trình sư tự động hóa AI toàn quyền tại [${p}].
MỤC TIÊU:
1. Vận hành cỗ máy sản xuất video Reels chủ đề [${topic}] và xuất bản an toàn cho [${pages}] Fanpage.
2. Quy định Caption vàng: 50–100 ký tự, mở đầu bằng câu hỏi khiêu khích, cấm ký tự «...», kèm 5 hashtag ngách.
3. Nhịp an toàn: Giữ delay ngẫu nhiên 45–75 giây giữa các trang trong Meta Business Suite.
4. Báo cáo Telegram Chat ID: [${tele}]. Chụp ảnh màn hình bằng chứng sau mỗi lượt đăng.
5. Duy trì PROJECT_STATE.md và tự chữa lành (Self-Healing) khi gặp lỗi, tuyệt đối không dừng luồng.
==============================================================================`;

      document.getElementById('genOutputBox').textContent = promptText;
    }

    function copyGeneratedScript() {
      const text = document.getElementById('genOutputBox').textContent;
      navigator.clipboard.writeText(text).then(() => {
        showToast('Đã sao chép Siêu câu lệnh Antigravity!');
      });
    }

    function downloadScript(fileName) {
      const p = document.getElementById('genPath').value || 'D:\\LPN_Workspace';
      let content = '';

      if (fileName === 'Setup_Tu_Dong.bat') {
        content = `@echo off
chcp 65001 >nul
title KHOI TAO HE THONG TU DONG HOA AI LEPHUCNHAT.VN
echo [1/4] Kiem tra quyen Administrator...
echo [2/4] Chuyen den thu muc lam viec: ${p}
cd /d "${p}"
echo [3/4] Chay script PowerShell cap quyen tu dong...
powershell -ExecutionPolicy RemoteSigned -File "${p}\\Setup_Tu_Dong.ps1"
echo [4/4] Hoan tat! Chuc mung ban da khoi tao thanh cong.
pause`;
      } else if (fileName === 'Setup_Tu_Dong.ps1') {
        content = `# PowerShell Setup Script - Master Command 3.0
Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser -Force
Write-Host ">>> Cap quyen PowerShell thanh cong!" -ForegroundColor Green

python -m pip install --upgrade pip
python -m pip install playwright python-dotenv requests google-genai pyTelegramBotAPI
python -m playwright install chromium
Write-Host ">>> Thu vien Python & Playwright Chromium da san sang!" -ForegroundColor Cyan`;
      } else if (fileName === '.env.template') {
        content = `# File Mau Cau Hinh Bien Moi Truong - Master Command 3.0
# Luu y: Khong duoc chia se khoa that len mang!
DEEPSEEK_API_KEY=sk-xxxx-dien-khoa-deepseek-tai-day
GEMINI_API_KEY=AQ-xxxx-dien-khoa-gemini-tai-day
TELEGRAM_BOT_TOKEN=0000000000:xxxx-token-bot-telegram
TELEGRAM_CHAT_ID=${document.getElementById('genTelegram').value || '123456789'}`;
      } else if (fileName === 'starter_agent.py') {
        content = `# starter_agent.py - Dieu Phuc Khoi Dong Tu Dong
import os, sys, time
from dotenv import load_dotenv

load_dotenv(override=True)
print("=== MASTER COMMAND 3.0 PRO AUTOMATION AGENT ===")
print("Thu muc lam viec: ${p}")
print("Trang thai: San sang thuc thi!")`;
      }

      const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = fileName;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast(`Đã tải xuống tệp: ${fileName}`);
    }

    /* ================= 6. MÔ-ĐUN 02: CAPTION & HOOK SIMULATOR ================= */
    const nicheHashtagsData = {
      thien: ['#BinhAnTuTam', '#SongAnNhien', '#ChuaLanhTamHon', '#TrietLyCuocSong', '#GocNhinSauSac'],
      happyrun: ['#HappyRun108', '#LePhucNhat', '#ChayBoMoiNgay', '#KyLuatBanThan', '#ChinhPhucMucTieu'],
      trietly: ['#ThuatGiaKim', '#GiacNgoTamHon', '#BaiHocCuocSong', '#PhatTrienBanThan', '#TuDuyTichCuc'],
      lamnghiep: ['#LamNghiepBenVung', '#HopTacXaKeoSon', '#GiuRungXanh', '#NongSanViet', '#DuocLieuSach'],
      congnghe: ['#AIChoMoiNguoi', '#TuDongHoaAI', '#MasterCommand', '#CongNghe40', '#PhanMemViet']
    };

    function analyzeCaption() {
      const text = document.getElementById('captionInput').value;
      const count = text.length;
      document.getElementById('captionCharCount').textContent = count;

      const title = document.getElementById('videoTitleInput').value.trim();
      const badge = document.getElementById('captionGoldBadge');

      // Rule 1: Length 50 - 100
      const isLengthOk = count >= 50 && count <= 100;
      updateCheckItem('chkLength', isLengthOk, `Độ dài: ${count}/100 ký tự ${isLengthOk ? '✅ (Chuẩn vàng)' : count < 50 ? '⚠️ (Quá ngắn < 50)' : '❌ (Quá dài > 100, sẽ bị ẩn nút xem thêm)'}`);

      // Rule 2: Quotes check
      const hasBadQuotes = /[«»]/.test(text);
      updateCheckItem('chkQuotes', !hasBadQuotes, hasBadQuotes ? '❌ Có ký tự ngoặc máy móc «...»' : '✅ Không có ký tự lạ máy móc');

      // Rule 3: Question check in first 30 chars
      const first30 = text.substring(0, 30);
      const hasQuestion = /[?？]/.test(first30) || /(bạn có|tại sao|bao giờ|ai|đã từng|có bao giờ)/i.test(first30);
      updateCheckItem('chkQuestion', hasQuestion, hasQuestion ? '✅ Mở đầu bằng câu hỏi gợi mở trong 30 ký tự đầu' : '⚠️ Nên mở đầu bằng câu hỏi (Bạn có/Bao giờ...) để kéo comment');

      // Rule 4: Duplicate with video title
      const isDuplicate = title.length > 0 && text.toLowerCase().includes(title.toLowerCase());
      updateCheckItem('chkDuplicate', !isDuplicate, isDuplicate ? '❌ Caption đang lặp lại nguyên văn tiêu đề video!' : '✅ Nội dung bổ trợ độc lập với tiêu đề video');

      if (isLengthOk && !hasBadQuotes && !isDuplicate) {
        badge.textContent = 'CHUẨN VÀNG 100%';
        badge.className = 'text-xs font-bold px-2.5 py-1 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 animate-pulse';
      } else {
        badge.textContent = 'CHƯA ĐẠT CHUẨN';
        badge.className = 'text-xs font-bold px-2.5 py-1 rounded bg-slate-800 text-slate-400 border border-slate-700';
      }
    }

    function updateCheckItem(id, passed, text) {
      const el = document.getElementById(id);
      if (!el) return;
      el.textContent = text;
      el.className = passed ? 'text-emerald-400 font-medium' : 'text-slate-400';
    }

    function generateNicheHashtags() {
      const topic = document.getElementById('hashtagTopicSelect').value;
      const tags = nicheHashtagsData[topic] || nicheHashtagsData.thien;
      const box = document.getElementById('hashtagBox');
      box.innerHTML = '';
      tags.forEach(t => {
        const span = document.createElement('span');
        span.className = 'px-2 py-1 rounded bg-cyan-950/60 text-cyan-300 border border-cyan-800 text-[11px] font-mono';
        span.textContent = t;
        box.appendChild(span);
      });
      showToast('Đã sinh 5 hashtag ngách tối ưu!');
    }

    function copyGeneratedHashtags() {
      const spans = document.querySelectorAll('#hashtagBox span');
      const tags = Array.from(spans).map(s => s.textContent).join(' ');
      navigator.clipboard.writeText(tags).then(() => {
        showToast('Đã copy 5 hashtag ngách!');
      });
    }

    /* ================= 7. MÔ-ĐUN 04: GAMIFIED CHECKLIST ================= */
    const defaultChecklist = [
      { id: 'c1', label: 'Cấp quyền thực thi PowerShell: Set-ExecutionPolicy RemoteSigned', done: true },
      { id: 'c2', label: 'Cài đặt Python 3.12, pip, Playwright Chromium và thư viện lõi', done: true },
      { id: 'c3', label: 'Cấu hình đường dẫn FFmpeg vào biến môi trường hệ thống PATH', done: true },
      { id: 'c4', label: 'Cấp quyền vĩnh viễn Option 3 (Always allow in this workspace) cho AI Agent', done: true },
      { id: 'c5', label: 'Tạo file .env hoặc Windows User Env chứa DEEPSEEK_API_KEY & GEMINI_API_KEY', done: true },
      { id: 'c6', label: 'Quy hoạch kho B-Roll 9:16 và kiểm tra script render FFmpeg', done: false },
