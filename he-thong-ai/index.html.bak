ffmpeg -y -i input.mp4 -i audio.mp3 -filter_complex "[0:v]scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920[v];[1:a]volume=0.35[a]" -map "[v]" -map "[a]" -c:v libx264 -preset fast -crf 22 -c:a aac -b:a 192k -shortest output_reels.mp4
          </div>
